{
  "name": "Proposal Status Change Notifications",
  "description": "Sends in-app notifications to board members when proposal status changes to 'in_progress' or 'completed'",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.data.status == \"in_progress\") or (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "BoardProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "proposal_status_change_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyProposalStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyProposalStatusChange"
  }
}