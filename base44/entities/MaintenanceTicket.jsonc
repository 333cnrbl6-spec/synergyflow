{
  "name": "MaintenanceTicket",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Related property ID"
    },
    "property_name": {
      "type": "string",
      "description": "Property name for reference"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant who reported the issue"
    },
    "tenant_name": {
      "type": "string",
      "description": "Tenant name for reference"
    },
    "tenant_email": {
      "type": "string",
      "description": "Tenant email for notifications"
    },
    "tenant_phone": {
      "type": "string",
      "description": "Tenant phone for follow-up"
    },
    "ticket_number": {
      "type": "string",
      "description": "Unique ticket reference (auto-generated)"
    },
    "category": {
      "type": "string",
      "enum": [
        "plumbing",
        "electrical",
        "heating",
        "appliance",
        "structural",
        "cleaning",
        "pest_control",
        "garden",
        "other"
      ],
      "description": "Category of maintenance issue"
    },
    "title": {
      "type": "string",
      "description": "Brief description of issue"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the problem"
    },
    "location": {
      "type": "string",
      "description": "Location within property (e.g., Kitchen, Bedroom 1)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium",
      "description": "Priority level"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "acknowledged",
        "in_progress",
        "completed",
        "on_hold",
        "cancelled"
      ],
      "default": "pending",
      "description": "Current ticket status"
    },
    "reported_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the issue was reported"
    },
    "target_completion_date": {
      "type": "string",
      "format": "date",
      "description": "Target date for completion"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the issue was resolved"
    },
    "assigned_to": {
      "type": "string",
      "description": "Contractor or staff member assigned"
    },
    "work_order_id": {
      "type": "string",
      "description": "Link to WorkOrder record"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Estimated repair cost in pounds"
    },
    "actual_cost": {
      "type": "number",
      "description": "Actual cost after completion"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes (not visible to tenants)"
    },
    "tenant_notes": {
      "type": "string",
      "description": "Notes from tenant about the issue"
    },
    "image_url": {
      "type": "string",
      "description": "URL of uploaded issue image"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of additional attachments"
    }
  },
  "required": [
    "property_id",
    "tenant_id",
    "title",
    "description",
    "category"
  ]
}