{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "description": "Unique ticket number"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "product_id": {
      "type": "string",
      "description": "Related product"
    },
    "subject": {
      "type": "string",
      "description": "Ticket subject"
    },
    "description": {
      "type": "string",
      "description": "Issue description"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Ticket status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Support agent email"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Ticket created date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date ticket was resolved"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attachment URLs"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "customer_email",
    "subject",
    "description"
  ]
}