{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_company": {
      "type": "string",
      "description": "Customer company name"
    },
    "subscription_id": {
      "type": "string",
      "description": "Related subscription ID"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice number"
    },
    "amount": {
      "type": "number",
      "description": "Amount in cents"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "refunded"
      ],
      "default": "sent",
      "description": "Invoice status"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment received"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "Stripe invoice ID"
    },
    "pdf_url": {
      "type": "string",
      "description": "Invoice PDF URL"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "customer_email",
    "amount",
    "invoice_date"
  ]
}