{
  "name": "BoardProposal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title of the proposal"
    },
    "summary": {
      "type": "string",
      "description": "What the board collectively proposes"
    },
    "raised_by": {
      "type": "string",
      "description": "Which board member(s) raised this"
    },
    "channel_id": {
      "type": "string",
      "description": "Channel where this was discussed"
    },
    "channel_name": {
      "type": "string"
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "build",
        "pricing",
        "go_to_market",
        "partnership",
        "governance",
        "readiness"
      ],
      "description": "Category of proposal"
    },
    "products_involved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which products this affects"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_chairman",
        "approved",
        "rejected",
        "deferred"
      ],
      "default": "pending_chairman",
      "description": "Chairman approval status"
    },
    "is_unanimous": {
      "type": "boolean",
      "default": false,
      "description": "Was the vote unanimous"
    },
    "approval_stage": {
      "type": "string",
      "enum": [
        "needs_review",
        "discussion_required",
        "final_approval",
        "passed",
        "rejected"
      ],
      "default": "needs_review",
      "description": "Multi-stage approval for non-unanimous proposals"
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_by": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Approval stage history"
    },
    "discussion_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of discussion messages"
    },
    "yes_votes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Board members who voted yes"
    },
    "no_votes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Board members who voted no"
    },
    "abstain_votes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Board members who abstained"
    },
    "chairman_notes": {
      "type": "string",
      "description": "Chairman feedback/decision notes"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "summary",
    "raised_by",
    "channel_id",
    "proposal_type"
  ]
}